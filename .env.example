# AWS S3 / Cloudflare R2 image storage (optional)
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_PUBLIC_URL=https://your-custom-cdn-domain.com

# Optional Python binary override (defaults to auto-detecting .venv or system python)
# PY_EXECUTABLE=/usr/bin/python3

